[Unit]
Description=TigerApps Discord bot Cloudflare Tunnel
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/tigerapps-discord-bot

[Service]
ExecStart=/usr/local/bin/cloudflared tunnel run --token-file /var/lib/tigerapps-discord-bot/cloudflare-token
Restart=always
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
